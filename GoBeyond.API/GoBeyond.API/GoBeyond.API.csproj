<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jedini konfiguracijski fajl (korijen repozitorija) kopira se uz aplikaciju. -->
    <Content Include="..\..\appsettings.Shared.json" Link="appsettings.Shared.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Fajlovi koje korisnici uploaduju nisu dio build-a (u Dockeru su u volume-u). -->
    <Content Remove="wwwroot\uploads\**" />
    <None Remove="wwwroot\uploads\**" />
    <None Remove="private-files\**" />
    <!-- Privatni demo certifikati: izvan wwwroot (nisu javni), ali se kopiraju uz aplikaciju i u Docker image. -->
    <None Update="SeedFiles\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Svi Microsoft.IdentityModel.* paketi moraju imati istu verziju (JwtBearer + System.IdentityModel.Tokens.Jwt). -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GoBeyond.Core\GoBeyond.Core.csproj" />
    <ProjectReference Include="..\GoBeyond.Infrastructure\GoBeyond.Infrastructure.csproj" />
  </ItemGroup>

</Project>
