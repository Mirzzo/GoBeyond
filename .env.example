# Optional overrides. Local defaults are centralized in appsettings.Shared.json.
# Copy to .env; never commit actual secrets. Compose works without this file.
Payments__Mode=Demo
# Set Mode=Stripe and supply your real Stripe TEST keys to exercise PaymentSheet.
Payments__SecretKey=
Payments__PublishableKey=
Payments__WebhookSecret=
# Forward Stripe CLI events to http://localhost:5000/api/payments/webhook.
# Production deployments must override the demo JWT and database/broker credentials.
# Jwt__SecretKey=
# SQL_PASSWORD=
# RABBITMQ_USERNAME=
# RABBITMQ_PASSWORD=
