# GoBeyond - opcionalne lokalne postavke za docker-compose I za lokalno pokretanje API-ja i
# EmailConsumer-a (dotnet run / Visual Studio / VS Code čitaju isti root .env pri startu).
# Kopirajte ovaj fajl u ".env" (fajl .env se NE commita). Bez .env fajla sve radi sa demo
# vrijednostima iz appsettings.Shared.json, osim Stripe plaćanja koje traži TEST ključeve.
# Varijable u formatu Sekcija__Kljuc pregaze odgovarajuću vrijednost iz appsettings.Shared.json.
# Već postavljene environment varijable (docker-compose, launchSettings.json) imaju prednost nad .env.

# --- Stripe (TEST mod) --------------------------------------------------------------------
# Ključevi: https://dashboard.stripe.com/test/apikeys  (secret počinje sa "sk_test_", publishable sa "pk_test_")
# Dok ključevi nisu postavljeni, POST /api/payments/create-intent vraća
# 400 "Stripe plaćanje nije konfigurisano na serveru."
Payments__SecretKey=
Payments__PublishableKey=
# Webhook secret ("whsec_..."), opcionalno, npr. iz Stripe CLI (važi dok "stripe listen" radi):
#   stripe listen --events payment_intent.succeeded,payment_intent.payment_failed,payment_intent.canceled --forward-to http://localhost:5000/api/payments/webhook
# Bez njega webhook odbija pozive, a plaćanje se potvrđuje preko POST /api/payments/{paymentId}/confirm.
Payments__WebhookSecret=

# --- Opcionalno: vlastite lozinke umjesto demo vrijednosti -----------------------------------
# SQL_PASSWORD=GoBeyondDemo!210020
# RABBITMQ_USERNAME=gobeyond
# RABBITMQ_PASSWORD=GoBeyondDemoRabbit
# Jwt__SecretKey=zamijenite-sa-najmanje-32-znaka-dugim-tajnim-kljucem

# --- Opcionalno: stvarna dostava emaila preko Gmail-a (podrazumijevano se koristi Mailpit) ---
# Bez ovih postavki SVI emailovi idu na Mailpit (http://localhost:8025), ništa ne napušta mašinu -
# docker-compose.yml koristi Mailpit kao podrazumijevanu vrijednost (Smtp__Host/Smtp__Port), pa
# ocjenjivanje/testiranje bez ovih varijabli radi identično kao prije.
#
# Za Gmail: 1) na Gmail nalogu uključite dvostepenu verifikaciju (2-Step Verification);
#           2) napravite App Password na https://myaccount.google.com/apppasswords
#              (obična lozinka naloga NE radi za SMTP); 3) popunite ispod i pokrenite
#              "docker compose up -d --build" da se email-consumer rekreira.
# Gmail zahtijeva da "From" bude tačno prijavljeni nalog (Smtp__Username), inače ga sam prepiše.
# Smtp__Host=smtp.gmail.com
# Smtp__Port=587
# Smtp__UseSsl=true
# Smtp__Username=vas.nalog@gmail.com
# Smtp__Password=<app password, ne obična lozinka>
# Smtp__FromEmail=vas.nalog@gmail.com
# Smtp__FromName=GoBeyond
#
# Zaštita seed/demo adresa: dok je Smtp__Host Mailpit, sav email (uključujući seed korisnike na
# "{username}@gobeyond.ba") ide normalno jer ostaje na mašini. Čim je Smtp__Host stvaran SMTP
# server (npr. Gmail iznad), GoBeyond.EmailConsumer NE šalje email na domene navedene u
# appsettings.Shared.json → Smtp:SuppressedRecipientDomains (podrazumijevano ["gobeyond.ba"]);
# takva poruka se samo loguje ("suppressed") i potvrđuje, bez slanja i bez dead-lettera. Ovo
# štiti stvarni SMTP nalog i treće strane od izmišljenih/demo adresa iz seed podataka.
